# Copy to .env and fill in. Never commit .env.
# FYP-1 (legacy/fyp1) reads these; load_dotenv() finds this file at the repo root.
FERNET_KEY=
FLASK_SECRET=
FLASK_ENV=
JWT_SECRET_KEY=
MAIL_DEV_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=
# Optional: overrides the SQLite database (the tests set this to a temp file)
DATABASE_URL=

# Platform (docker compose, project 'vaultic'; D231). Ports are bound to 127.0.0.1 and chosen so this
# stack runs beside other local projects (e.g. one on PostgreSQL 5433 and Redis 6379).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Older key, still read if VAULTIC_POSTGRES_PORT is not set
POSTGRES_PORT=
VAULTIC_POSTGRES_PORT=5442
VAULTIC_REDIS_PORT=6390
VAULTIC_KAFKA_PORT=9094
# Optional: a full connection URL instead of the POSTGRES_* keys
VAULTIC_DB_URL=
