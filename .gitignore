# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Virtual environment (recreate with: py -3.11 -m venv .venv)
.venv/
.venv-torch/
.venv-dice/

# Secrets
.env

# IDE
.idea/
.vscode/

# Data: never committed. Raw IEEE-CIS CSVs are tracked with DVC instead.
data/raw/*
data/interim/*
data/features/*
!data/*/.gitkeep
!data/raw/*.dvc
!data/raw/.gitignore
*.csv
*.parquet

# Databases
*.db
*.sqlite
*.sqlite3

# Model binaries
*.joblib
*.pkl
*.pt
*.pth
*.ckpt

